# ============================================================
#  galileo.env.example  —  copia in galileo.env e compila
# ============================================================
# Questo file e' un template. NON inserire chiavi vere qui.
# Copia il file come galileo.env (accanto all'exe o allo script)
# e incolla le tue chiavi API.

# --- Google Gemini (obbligatoria per il provider principale) ---
# Ottieni su: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- OpenRouter (fallback testo, tier gratuito) ---
# Ottieni su: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Anthropic Claude (opzionale: per compiti complessi, codice e refactoring) ---
# Ottieni su: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Cloudflare (generazione immagini con Flux) ---
# Account ID: https://dash.cloudflare.com/ → overview destra
# API Token:  https://dash.cloudflare.com/profile/api-tokens (permesso AI Gateway)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# --- Hugging Face (generazione video, opzionale) ---
# Ottieni su: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here